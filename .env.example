# ==============================================================================
# FantaSKI Frontend - Przykładowa konfiguracja środowiska (.env.example)
# Skopiuj ten plik do .env (lub .env.test dla profilu testowego)
# ==============================================================================

# Adres URL backendu FantaSKI API (np. http://localhost:8000 lokalnie lub https://twoj-backend.onrender.com)
VITE_API_URL=http://localhost:8000

# Google OAuth 2.0 Web Client ID (z Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=twoj-google-client-id.apps.googleusercontent.com

# Nazwa profilu środowiska (DEV, TEST, PROD)
VITE_ENV_NAME=DEV
